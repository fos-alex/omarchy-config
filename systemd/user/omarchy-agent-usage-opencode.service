[Unit]
Description=OpenCode agent usage record for the omarchy agents panel

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'mkdir -p "%h/.local/state/omarchy/agents/usage" && %h/.local/bin/omarchy-agent-usage-opencode > "%h/.local/state/omarchy/agents/usage/.opencode.json.tmp" && mv "%h/.local/state/omarchy/agents/usage/.opencode.json.tmp" "%h/.local/state/omarchy/agents/usage/opencode.json"'
